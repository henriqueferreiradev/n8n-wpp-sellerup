# Copie para .env e preencha com os dados do seu projeto no Supabase.
# .env está no .gitignore — não commite credenciais.
#
# Onde achar: painel do Supabase → Project Settings → Database → Connection string
# (aba "URI" para a DATABASE_URL, aba "Parameters" para os campos separados).

# --- Forma direta: uma URL só (usada pelos comandos do README) ---
# Use o pooler (porta 6543) para conexões de app/N8N; a conexão direta
# (porta 5432) é a indicada para rodar migrations.
DATABASE_URL=postgresql://postgres.<project-ref>:<SUA_SENHA>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# --- Mesmos dados, em campos separados (é o formato que o N8N pede) ---
SUPABASE_DB_HOST=aws-0-<regiao>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=<SUA_SENHA>
