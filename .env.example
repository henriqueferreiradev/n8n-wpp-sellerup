# Copie para .env e preencha com os dados do seu projeto no Supabase.
# .env está no .gitignore — não commite credenciais.
#
# Onde achar: painel do Supabase → Project Settings → Database → Connection string
# (aba "URI" para a DATABASE_URL, aba "Parameters" para os campos separados).

# --- Forma direta: uma URL só (usada pelos comandos do README) ---
# Use o pooler (porta 6543) para conexões de app/N8N; a conexão direta
# (porta 5432) é a indicada para rodar migrations.
DATABASE_URL=postgresql://postgres.<project-ref>:<SUA_SENHA>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# --- Mesmos dados, em campos separados (é o formato que o N8N pede) ---
SUPABASE_DB_HOST=aws-0-<regiao>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=<SUA_SENHA>

# --- Bloco (c): busca real, geração de fotos/título/descrição ---
# Nada aqui é lido por este repo (não há backend próprio). Estas 5 chaves são
# as que o n8n self-hosted precisa ter como VARIÁVEIS DE AMBIENTE do container:
# copie o bloco abaixo para o .env que o docker-compose.yml do n8n usa (não é
# este arquivo — é o .env do host onde o n8n roda) e recrie o container com
#   docker compose up -d --force-recreate n8n
# Os 4 Code nodes do workflow leem esses valores via $env.NOME. Requer
# N8N_BLOCK_ENV_ACCESS_IN_NODE não setada ou false (default é false).
# Passo a passo completo em docs/gemini-supabase-storage-setup.md.
GEMINI_API_KEY=<sua-chave-aistudio.google.com/apikey>
OPENAI_API_KEY=<sua-chave-platform.openai.com/api-keys>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role-key-do-Project-Settings-API>
SUPABASE_STORAGE_BUCKET=listing-photos
